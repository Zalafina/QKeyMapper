+        bool has_started_mouse() const {
+            if (device_path.compare(0, 4, LR"(\??\)") != 0)
+                return false;
+            const auto end = device_path.find(L"#{", 4);
+            if (end == std::wstring::npos)
+                return false;
+            std::wstring instance = device_path.substr(4, end - 4);
+            std::replace(instance.begin(), instance.end(), L'#', L'\\');
+            DEVINST bus = 0;
+            if (CM_Locate_DevNodeW(&bus, instance.data(), CM_LOCATE_DEVNODE_NORMAL) != CR_SUCCESS
+                || !property_equals(bus, CM_DRP_HARDWAREID, LR"(root\LGHUBVirtualBus)"))
+                return false;
+            std::array<DEVINST, 64> pending{};
+            size_t count = 0, next = 0;
+            DEVINST child = 0;
+            if (CM_Get_Child(&child, bus, 0) != CR_SUCCESS)
+                return false;
+            pending[count++] = child;
+            while (next < count) {
+                const DEVINST node = pending[next++];
+                ULONG status = 0, problem = 0;
+                if (CM_Get_DevNode_Status(&status, &problem, node, 0) == CR_SUCCESS
+                    && (status & DN_STARTED) && !(status & DN_HAS_PROBLEM)
+                    && property_equals(node, CM_DRP_CLASSGUID, L"{4d36e96f-e325-11ce-bfc1-08002be10318}"))
+                    return true;
+                for (auto query : { &CM_Get_Child, &CM_Get_Sibling }) {
+                    DEVINST related = 0;
+                    if (query(&related, node, 0) == CR_SUCCESS) {
+                        if (count == pending.size())
+                            return false;
+                        pending[count++] = related;
+                    }
+                }
+            }
+            return false;
+        }
